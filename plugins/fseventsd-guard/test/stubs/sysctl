#!/bin/bash
# Test stub: sysctl -n vm.swapusage, -n kern.boottime and -n kern.waketime print
# $FSG_FAKE/swapusage, $FSG_FAKE/boottime and $FSG_FAKE/waketime, else fixed values
# (no wake since a boot long ago); anything else is the real sysctl.
case "$*" in
  "-n vm.swapusage") cat "${FSG_FAKE:-/nonexistent}/swapusage" 2>/dev/null || echo "total = 2048.00M  used = 512.25M  free = 1535.75M  (encrypted)" ;;
  "-n kern.boottime") cat "${FSG_FAKE:-/nonexistent}/boottime" 2>/dev/null || echo "{ sec = 1760000000, usec = 0 } Thu Oct  9 08:53:20 2025" ;;
  "-n kern.waketime") cat "${FSG_FAKE:-/nonexistent}/waketime" 2>/dev/null || echo "{ sec = 0, usec = 0 } Thu Jan  1 00:00:00 1970" ;;
  *) exec /usr/sbin/sysctl "$@" ;;
esac
