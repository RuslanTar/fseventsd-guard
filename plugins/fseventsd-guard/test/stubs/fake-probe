#!/bin/bash
# Test stand-in for fsprobe. Result from $FSG_FAKE/probe-seq (one result per call,
# consumed in order), else $FSG_FAKE/probe, else ok. start_ms from
# $FSG_FAKE/probe-start-ms, else 0; eid from $FSG_FAKE/probe-eid, else none.
: "${FSG_FAKE:?}"
r=ok
if [ -s "$FSG_FAKE/probe-seq" ]; then
  r=$(head -n 1 "$FSG_FAKE/probe-seq")
  tail -n +2 "$FSG_FAKE/probe-seq" > "$FSG_FAKE/probe-seq.tmp" && mv "$FSG_FAKE/probe-seq.tmp" "$FSG_FAKE/probe-seq"
elif [ -f "$FSG_FAKE/probe" ]; then
  r=$(cat "$FSG_FAKE/probe")
fi
echo "probe $r" >> "$FSG_FAKE/calls.log"
# With $FSG_FAKE/probe-heartbeat: the age of the agent's heartbeat at this probe.
if [ -f "$FSG_FAKE/probe-heartbeat" ]; then
  e=$(sed -n 's/^epoch=//p' "$FSG_STATE_DIR/heartbeat" 2>/dev/null)
  [ -n "$e" ] && echo "probe heartbeat_age=$(( $(date +%s) - e ))" >> "$FSG_FAKE/calls.log"
fi
s=$(cat "$FSG_FAKE/probe-start-ms" 2>/dev/null || echo 0)
[ -f "$FSG_FAKE/probe-eid" ] && s="$s eid=$(cat "$FSG_FAKE/probe-eid")"
case $r in
  ok) echo "result=ok latency_ms=7 start_ms=$s"; exit 0 ;;
  stalled) echo "result=stalled timeout_s=${2:-10} start_ms=$s"; exit 2 ;;
  *) echo "result=error fake"; exit 3 ;;
esac
