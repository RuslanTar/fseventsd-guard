# fseventsd-guard defaults. Do not edit this file to tune one machine.
#
# Precedence, lowest first: this file, then the user config at
# "$HOME/Library/Application Support/fseventsd-guard/config" (`install` creates it
# with every line commented out), then FSG_* variables in the environment.
# docs/DESIGN.md explains each choice. The user config is read, never run as shell:
# only KEY=VALUE lines for a key below count (VALUE in letters, digits and . _ - : / @,
# with spaces only inside quotes); any other line is ignored, logged, and makes
# `doctor` warn. A setting whose default below is a number takes whole numbers only
# (MB and seconds, no units): any other value is replaced by the default, logged,
# and fails `doctor`.
#
# The plugin's hooks read this file from their own copy, which Claude Code refreshes
# from main when it updates the plugin ("Updates" in the repo README).

# --- Thresholds (MB of physical footprint, as top's MEM column reports it) ---------
# Apple's own launchd memory budget for fseventsd. Reported only.
FSG_BUDGET_MB=30
# Warn tier: notify only. A healthy daemon sat at 4-90 MB on the owner's Mac.
FSG_WARN_MB=500
# Emergency tier: the background agent heals (through the drain).
FSG_ACT_MB=2048
# CPU escalator: a footprint at or above warn with fseventsd at or above this share
# of one core (percent, from the CPU time it used between two ticks) for
# FSG_CPU_ESCALATE_TICKS ticks in a row counts as runaway, like the act threshold
# (0 = off). A runaway pins a core; a healthy daemon does not.
FSG_CPU_ESCALATE_PCT=50
FSG_CPU_ESCALATE_TICKS=3
# Seconds one `top` sample may take (it takes 1-2 s); a slower one counts as cannot
# measure.
FSG_TOP_TIMEOUT_S=15

# --- Delivery probe -----------------------------------------------------------------
# Seconds the probe waits for its own write to come back as an FSEvent.
FSG_PROBE_TIMEOUT_S=10
# `status` runs the probe only with --probe, or when this is 1.
FSG_STATUS_PROBE=0
# The background agent probes on every tick. A stall is confirmed by an immediate
# second probe before it counts.
FSG_AGENT_PROBE=1

# --- Background agent ---------------------------------------------------------------
# launchd StartInterval of the agent (rendered into the plist at install).
FSG_AGENT_INTERVAL_S=300
# At most one emergency heal per this many seconds, counted from the newest of: the
# last restart the guard made for any reason, the last heal attempt that reached the
# Docker step (even if the restart then failed), and the root helper's own stamp.
# Inside the window the agent notifies only.
FSG_EMERGENCY_MIN_INTERVAL_S=10800
# Repeat a warn notification after this many minutes, or sooner if the footprint
# has doubled since the last one. Also the repeat limit of the other agent notices.
FSG_WARN_RENOTIFY_MIN=60
# Notify when this many ticks in a row could not measure fseventsd (the guard is
# blind then: no warnings, no heals).
FSG_BLIND_NOTIFY_TICKS=3

# --- Root helper (rendered into the root-owned copy at install; re-run install to
# --- change them, doctor reports drift) ----------------------------------------------
# The helper refuses to restart below this footprint: a healthy daemon is left alone.
FSG_HELPER_MIN_MB=150
# The helper's own rate limit, independent of the agent's.
FSG_HELPER_MIN_INTERVAL_S=1800
# `install --trial-hours N` opens a time-boxed window for the Docker trials with
# these looser limits. The window closes on its own; no second sudo needed.
FSG_TRIAL_MIN_MB=0
FSG_TRIAL_MIN_INTERVAL_S=120

# --- Install source gate ------------------------------------------------------------
# The repo whose main you trust: install runs root code only from a clone whose
# origin is this repo, at a tree equal to its origin/main. Any URL form (https,
# git@host:, ssh://) or host/owner/repo; compared without case. Set your fork here.
FSG_REVIEWED_ORIGIN=https://github.com/RuslanTar/fseventsd-guard

# --- Docker step --------------------------------------------------------------------
# A = stop the running containers, restart, start them again.
# B = quit Docker Desktop, restart, start Docker Desktop, start the containers.
# C = restart fseventsd, then restart Docker Desktop, start the containers.
# none = leave Docker alone (the naive restart; trial step 0 only).
# B is the default until the trials in docs/DOCKER-TRIALS.md pick a winner.
FSG_DOCKER_VARIANT=B
# Seconds for `docker desktop stop|start|restart` and for the engine to answer.
# The agent's launchd ExitTimeOut is derived from it at install (re-run install
# after changing it).
FSG_DOCKER_TIMEOUT_S=300
# Seconds `docker desktop status` and `docker info` get to answer. A Docker Desktop
# whose process runs but answers neither counts as wedged, not stopped: the heal
# restarts it and holds runs until it verifies.
FSG_DOCKER_QUERY_TIMEOUT_S=20
# Seconds variant B waits for Docker Desktop to stop, counted from the
# `docker desktop stop` call. Stopped: its status says so, or no Docker Desktop
# process runs and its sockets are gone.
FSG_DESKTOP_STOP_WAIT_S=60
# Seconds `docker stop -t` gives a container before SIGKILL.
FSG_STOP_TIMEOUT_S=30
# Seconds to wait for every recorded container to be running (and healthy, when it
# has a health check) after the restore.
FSG_CONTAINER_TIMEOUT_S=240
# Verify a bind mount both ways after the restore (needs a local image with /bin/sh;
# nothing is pulled).
FSG_VERIFY_BIND_MOUNT=1
# Image for the bind-mount probe. Empty = pick a local alpine/busybox/bash image,
# else the image of a recorded container.
FSG_PROBE_IMAGE=
# Host dir for the bind-mount probe (quote a path with spaces). Empty = the state
# dir's mountprobe when Docker Desktop shares it, else a dir in the first folder
# under your home in its File Sharing list. A probe dir Docker Desktop does not
# share skips the check (doctor warns).
FSG_PROBE_DIR=

# --- Heal ---------------------------------------------------------------------------
# Seconds to wait for a fresh, healthy fseventsd after the helper returns.
FSG_HEALTHY_TIMEOUT_S=90
# Seconds the root helper may take (it bounds its own steps; this catches a hang).
# It also sizes the agent's launchd ExitTimeOut (re-run install after changing it).
FSG_HELPER_TIMEOUT_S=300
# Slack added to each phase's worst case when the heal refreshes the drain deadline
# that held runs see. The worst case itself comes from the timeouts above, so a
# slow Docker restore never lets held runs start against a stopped engine; the
# deadline exists only so a crashed heal cannot hold runs for good.
FSG_DRAIN_SLACK_S=120

# --- Drain --------------------------------------------------------------------------
# Longest wait for leased runs (fseventsd-guard run, integrated runners) that
# started before the drain, before the cap policy applies.
# Owner data: an idle run takes up to ~10 min, a busy one up to ~80 min.
FSG_DRAIN_CAP_S=3600
# Longest wait for unleased work that started before the drain (the detection
# below), never longer than the drain cap. Nothing holds new unleased runs, so a
# longer wait only delays the heal; at this cap the same policy applies.
FSG_UNLEASED_CAP_S=600
# Seconds between drain polls.
FSG_DRAIN_POLL_S=15
# When a heal could not bring Docker back (heal exit 7 or 8 with Docker not
# restored), new runs stay held for at most this many seconds after it, unless the
# agent sees Docker healthy again (not after a trial) or `fseventsd-guard release`.
FSG_FAILED_HOLD_S=3600
# What happens at the cap: proceed (cut the remaining runs and notify which) or
# abort (give up, release the drain, notify).
FSG_CAP_POLICY_EMERGENCY=proceed
FSG_CAP_POLICY_MANUAL=abort
# After a wave heal gives up at the cap, further wave heals (from any session)
# return 11 without draining for this many minutes (0 = no back-off). Manual and
# emergency heals are not affected.
FSG_WAVE_RETRY_MIN=60
# Emergency heals stop waiting early when the footprint passes this (0 = never).
FSG_EMERGENCY_CUT_MB=8192
# The agent drops a heal request older than this when it takes it (exit 13): it
# was queued while the agent was unloaded or the user logged out.
FSG_REQUEST_MAX_AGE_S=7200

# --- Unleased work detection (fallback while runners are not integrated) -------------
# Treat matching processes as live work during a drain.
FSG_DETECT_PROCESSES=1
# A process matches when its command, or the command after a launcher, has one of
# these base names. Add your project's own test runner names in the user config
# (FSG_DETECT_COMMANDS="rspec parallel_rspec parallel_test my-runner"), or lease
# the runner instead (fseventsd-guard run, or lib/lease.sh).
FSG_DETECT_COMMANDS="rspec parallel_rspec parallel_test"
FSG_DETECT_LAUNCHERS="ruby bundle exec timeout gtimeout rtk env bash sh zsh nice nohup time caffeinate"
# Treat attached `docker run|exec` and `docker compose run|exec` CLIs as live work.
# An exec with a TTY run from a terminal is not waited for when it runs a shell or
# console (FSG_INTERACTIVE_COMMANDS); with a TTY, any other command is work.
FSG_DETECT_DOCKER_CLI=1
# Treat containers with exec sessions as live work; a session with a TTY for a shell
# or console, or with an open stdin and no TTY, is not waited for (asked of the
# engine API with curl).
FSG_DETECT_DOCKER_EXECS=1
# Treat running --rm containers (Docker deletes them when they stop) and one-off
# `docker compose run` containers (a heal never starts them again) as live work,
# by the time each started. Asked of the engine together with the exec sessions.
FSG_DETECT_DOCKER_CONTAINERS=1
# The shells and consoles a TTY exec is interactive for, by base name after the
# launchers above; prog:sub needs that first argument. A command line that also
# names an FSG_DETECT_COMMANDS word (`bash -c "bundle exec rspec"`) is work.
FSG_INTERACTIVE_COMMANDS="sh bash zsh psql rails:console rails:c irb redis-cli"

# --- Runner side (lib/lease.sh reads these from the environment or the user config) --
# Longest a run waits for a pending drain (0 = until the drain's own deadline).
FSG_RUN_MAX_WAIT_S=0
# At that limit: fail (exit 75) or proceed (start anyway).
FSG_RUN_ON_TIMEOUT=fail
# Seconds between a waiting run's checks.
FSG_RUN_POLL_S=5

# --- Affected macOS versions --------------------------------------------------------
# Affected: from the first version with a first-hand report of the runaway
# (docs/DESIGN.md "Affected versions" lists the reports) up to, not including, the
# first fixed version of its major line. No fix is known yet.
FSG_AFFECTED_MIN=15.6.1
# First fixed version per major line, space-separated: "26.8 27.1" means 26.x is
# fixed from 26.8 and 27.x from 27.1. A line without an entry has no known fix.
FSG_AFFECTED_FIXED=
# Force the answer (yes|no); empty = use the range.
FSG_AFFECTED=

# --- Notifications ------------------------------------------------------------------
FSG_NOTIFY=1
